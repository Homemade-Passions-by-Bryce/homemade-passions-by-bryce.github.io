# Supported by Cloudflare Pages and Netlify. Other hosts may ignore this file.
# HTML revalidates; content-hashed assets can be cached without hiding updates.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/images/optimized/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=86400
